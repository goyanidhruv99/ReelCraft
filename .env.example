# ReelCraft local environment
# Copy values into .env.local for local development.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reelcraft?schema=public"

# Local Ollama (Phase 2+) — never point the browser at arbitrary Ollama hosts.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=180000
